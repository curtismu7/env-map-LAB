# Optional. Everything has a safe default; Mock needs no settings and no network.
# Read from the shared settings file (~/Development/.env, or the file named by STANDALONE_ENV) and from the environment (the environment wins).
# PORT must be 7805 (this app's one allocated port).
PORT=7805
# ENV_MAP_BIND=127.0.0.1   # loopback only unless you set this on purpose (Real is then off)
# Real mode: a snapshot file (env-map/1) written by scripts/collect.sh. Absolute path, OUTSIDE this repo. Read-only, loopback only.
# ENV_MAP_SNAPSHOT=/path/to/env-map-snapshot.json
